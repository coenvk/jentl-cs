<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine's sources compiled against KNI instead of MonoGame, for the browser build. -->
  <PropertyGroup>
    <RootNamespace>Jentl.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Jentl.Core\**\*.cs" Exclude="..\Jentl.Core\bin\**;..\Jentl.Core\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="$(StbImageSharpVersion)" />
    <PackageReference Include="FontStashSharp.Kni" Version="$(FontStashSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="$(KniVersion)" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="$(KniVersion)" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="$(KniVersion)" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="$(KniVersion)" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="$(KniVersion)" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="$(KniVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jentl.Puzzle\Jentl.Puzzle.csproj" />
    <ProjectReference Include="..\Jentl.Cards\Jentl.Cards.csproj" />
    <ProjectReference Include="..\Jentl.Rpg\Jentl.Rpg.csproj" />
    <ProjectReference Include="..\Jentl.Ecs\Jentl.Ecs.csproj" />
    <ProjectReference Include="..\Jentl.Physics\Jentl.Physics.csproj" />
  </ItemGroup>

</Project>
