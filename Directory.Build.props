<Project>
  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName.Replace('-', '_'))</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <Authors>Coen van Kampen</Authors>
    <Company>Coen van Kampen</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Packages: one per library in src/, all versioned together (CI sets Version from the release tag). -->
  <PropertyGroup>
    <Version>0.4.2</Version>
    <PackageProjectUrl>https://github.com/coenvk/jentl-cs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/coenvk/jentl-cs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>jentl;game-engine;monogame;kni</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <GenerateDocumentationFile Condition="'$(IsPackable)' == 'true'">true</GenerateDocumentationFile>
    <!-- Public members (or some of their parameters) without XML comments are fine; the docs folder carries the guide. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)dependencies.props" />
</Project>
